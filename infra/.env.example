# Copy to infra/.env and fill in. Never commit .env.

# --- Postgres (also consumed by the postgres image itself) ---
POSTGRES_USER=croproute
POSTGRES_PASSWORD=croproute
POSTGRES_DB=croproute
POSTGRES_PORT=5432

# --- Connection strings used by the backend (hostnames = compose service names) ---
DATABASE_URL=postgresql+psycopg://croproute:croproute@postgres:5432/croproute
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- Baseline refresh cadence (hours, clamped to [6,12]) ---
# read by services/refresh_job.py (schedule) and services/search_cache.py (cache TTL)
REFRESH_INTERVAL_HOURS=8

# --- External APIs ---
# https://www.data.gov.in/ — Agmarknet mandi price dataset
DATA_GOV_API_KEY=
# https://brightdata.com/ — Scraper Studio trigger/poll + self-heal
BRIGHTDATA_API_KEY=
# where scrapers/<name>.json collector configs live (services/brightdata_service.py);
# default resolves to /scrapers inside the backend container, repo checkout otherwise
COLLECTORS_DIR=

# --- Ports / origins ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
# backend CORS allow-list
FRONTEND_ORIGIN=http://localhost:3000
# browser-side base URL for the frontend API client
NEXT_PUBLIC_API_URL=http://localhost:8000
